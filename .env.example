# 从环境读取；不要将真实凭据提交到仓库。
# 可省略 STOCKRADAR_TOKEN，首次启动会生成并保存到 data/.api-token。
STOCKRADAR_TOKEN=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 可选，只接受 HTTPS 标准行情网关；不代表已验证供应商覆盖或授权。
STOCKRADAR_PROVIDER_URL=
STOCKRADAR_PROVIDER_TOKEN=
# 仅独立 vendor-sample 使用；应用不自动加载 .env 或接入这些供应商。
TICKFLOW_API_KEY=
TUSHARE_TOKEN=
# 详情入口不可携带 API token；非本机部署请使用 TLS 反向代理。
STOCKRADAR_PUBLIC_URL=
